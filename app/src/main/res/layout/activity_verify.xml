<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trang web yêu cầu xác minh bạn là người thật (Cloudflare). Hãy tick vào ô xác minh trên trang, chờ trang phim hiện ra — app sẽ tự quay lại và tải tiếp. Vé xác minh được lưu lại, lâu lâu mới phải làm lại 1 lần."
        android:textSize="14sp" />

    <WebView
        android:id="@+id/wvVerify"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerifyDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Đã hiện trang phim — Quay lại app" />
</LinearLayout>
